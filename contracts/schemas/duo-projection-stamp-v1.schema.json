{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:duo:schema:projection-stamp:v1",
  "title": "Duo generated projection stamp v1",
  "type": "object",
  "required": ["schema", "product_version", "manifest_digest", "projection_format", "target", "installation_id", "generated_at", "source_assets", "files"],
  "properties": {
    "schema": {"const": "duo.projection-stamp/v1"},
    "product_version": {"type": "string", "minLength": 1},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "projection_format": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "required": ["harness", "tested_version_range"],
      "properties": {
        "harness": {"enum": ["claude_code", "codex", "devin", "opencode", "pi", "portable_launchers"]},
        "tested_version_range": {"type": "string", "minLength": 1},
        "launcher_eligibility": {"const": "capability_evidence"},
        "launchers": {
          "type": "array",
          "items": {"$ref": "#/$defs/launcher"},
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "components": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "installation_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_assets": {"$ref": "#/$defs/digested_paths"},
    "files": {"$ref": "#/$defs/digested_paths"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "properties": {"harness": {"const": "portable_launchers"}},
            "required": ["harness"]
          }
        },
        "required": ["target"]
      },
      "then": {
        "required": ["components"],
        "properties": {
          "target": {"required": ["launchers"]},
          "components": {
            "items": {"const": "filesystem_skill"},
            "maxItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "launcher": {
      "type": "object",
      "required": ["name", "tested_versions"],
      "properties": {
        "name": {"enum": ["amp", "opencode", "codex"]},
        "tested_versions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "digested_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "digest"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  }
}
