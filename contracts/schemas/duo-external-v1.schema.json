{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:duo:schema:external:v1",
  "title": "Duo external v1 core wire document",
  "oneOf": [
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/failure"},
    {"$ref": "#/$defs/stream_item"}
  ],
  "allOf": [
    {
      "if": {
        "required": ["stream", "kind"],
        "properties": {
          "stream": {"const": "session.condition"},
          "kind": {"const": "view.changed"}
        }
      },
      "then": {
        "properties": {"data": {"$ref": "#/$defs/condition_view_data"}}
      }
    },
    {
      "if": {
        "required": ["stream"],
        "properties": {"stream": {"const": "command.results"}}
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "responsibility_state": {"$ref": "#/$defs/responsibility_state"},
              "queue_policy": {"$ref": "#/$defs/queue_policy"},
              "effect": {"$ref": "#/$defs/effect"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["stream"],
        "properties": {"stream": {"const": "usage"}}
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {"freshness": {"$ref": "#/$defs/freshness"}}
          }
        }
      }
    },
    {
      "if": {
        "required": ["stream"],
        "properties": {"stream": {"const": "session.runtime_configuration"}}
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "revision": {"$ref": "#/$defs/decimal"},
              "selected": {"$ref": "#/$defs/model_identity"},
              "effective": {"$ref": "#/$defs/model_identity"},
              "selected_working_mode": {"$ref": "#/$defs/working_mode"},
              "effective_working_mode": {"$ref": "#/$defs/working_mode"},
              "source_record": {"$ref": "#/$defs/target"},
              "freshness": {"$ref": "#/$defs/freshness"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["operation", "result"],
        "properties": {"operation": {"const": "session.inspect"}}
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "lifecycle": {"$ref": "#/$defs/lifecycle"},
              "condition": {"$ref": "#/$defs/condition_view_data"},
              "runtime_configuration": {"$ref": "#/$defs/runtime_configuration_view"},
              "operations": {
                "type": "array",
                "items": {"$ref": "#/$defs/support_view"}
              },
              "attachments": {
                "type": "array",
                "items": {"$ref": "#/$defs/session_attachment_inspect"}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["operation", "result"],
        "properties": {
          "operation": {"enum": ["prompt.deliver", "command.inspect"]}
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "responsibility_state": {"$ref": "#/$defs/responsibility_state"},
              "queue_policy": {"$ref": "#/$defs/queue_policy"},
              "effect": {"$ref": "#/$defs/effect"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["operation", "result"],
        "properties": {
          "operation": {
            "enum": [
              "prompt.lease.acquire",
              "prompt.lease.renew",
              "prompt.lease.release",
              "prompt.lease.inspect"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {"state": {"$ref": "#/$defs/lease_state"}}
          }
        }
      }
    },
    {
      "if": {
        "required": ["operation", "result"],
        "properties": {"operation": {"const": "session.launch"}}
      },
      "then": {
        "properties": {"result": {"$ref": "#/$defs/launch_resolution_report"}}
      }
    },
    {
      "if": {
        "required": ["error"],
        "properties": {
          "error": {
            "required": ["code"],
            "properties": {
              "code": {
                "enum": [
                  "launch.constraints_exhausted",
                  "launch.no_eligible_candidate"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {"details": {"$ref": "#/$defs/launch_failure_details"}}
          }
        }
      }
    },
    {
      "if": {
        "required": ["error"],
        "properties": {
          "error": {
            "required": ["code"],
            "properties": {"code": {"const": "launch.host_unresolved"}}
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "required": ["details"],
            "properties": {
              "code": {"$ref": "#/$defs/launch_host_unresolved_code"},
              "class": {"const": "unavailable"},
              "effect": {"const": "no_effect"},
              "details": {"$ref": "#/$defs/launch_host_unresolved_details"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["error"],
        "properties": {
          "error": {
            "required": ["code"],
            "properties": {"code": {"const": "config.variant_unresolved"}}
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {"$ref": "#/$defs/config_variant_unresolved_code"},
              "class": {"const": "unavailable"},
              "effect": {"const": "no_effect"},
              "details": {"$ref": "#/$defs/config_declaration_details"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["error"],
        "properties": {
          "error": {
            "required": ["code"],
            "properties": {"code": {"const": "config.composition_unresolved"}}
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {"code": {"$ref": "#/$defs/config_composition_unresolved_code"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "schema": {"const": "duo.external/v1"},
    "opaque_id": {"type": "string", "minLength": 1},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "effect": {"enum": ["no_effect", "unknown_effect"]},
    "condition_value": {"enum": ["idle", "working", "blocked", "done", "exited", "unknown"]},
    "confidence": {"enum": ["reported", "inferred", "heuristic", "unknown"]},
    "freshness": {"enum": ["fresh", "stale", "expired", "unknown"]},
    "responsibility_state": {"enum": ["accepted", "queued", "attempting", "delivered", "expired", "canceled", "failed"]},
    "queue_policy": {"enum": ["require_ready", "queue_until_safe", "hold_for_release"]},
    "availability": {"enum": ["available", "temporarily_unavailable", "unsupported"]},
    "quality": {"enum": ["exact", "degraded", "heuristic"]},
    "realization": {"enum": ["native", "adapted", "synthesized"]},
    "terminal_fidelity": {"enum": ["incremental", "repaint_only", "snapshot_only", "absent"]},
    "lifecycle": {"enum": ["active", "archived", "removed"]},
    "collaboration_kind": {"enum": ["shared_value", "shared_document", "inbox", "timer", "subscription"]},
    "lease_state": {"enum": ["active", "released", "expired", "revoked", "void"]},
    "launch_constraint_axis": {"enum": ["agent_runtime", "model_line", "model_family"]},
    "launch_relation_kind": {"enum": ["distinct_model_line", "distinct_model_family"]},
    "launch_elimination_reason": {
      "enum": [
        "session_host_disabled",
        "no_conformance_evidence",
        "require_unmatched",
        "avoid_matched",
        "provider_disabled"
      ]
    },
    "host_source": {"enum": ["explicit-flag", "workspace-correlation", "cwd-correlation", "ambient-env", "policy-default"]},
    "launch_constraint_predicate": {
      "type": "object",
      "required": ["axis", "value"],
      "properties": {
        "axis": {"$ref": "#/$defs/launch_constraint_axis"},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "launch_resolution_leaf": {
      "type": "object",
      "required": ["name", "agent_runtime", "model_line", "declared_kind", "outcome", "relented_avoids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "agent_runtime": {"type": "string", "minLength": 1},
        "model_line": {"type": "string", "minLength": 1},
        "model_family": {"type": "string", "minLength": 1},
        "composition": {"$ref": "#/$defs/minted_composition"},
        "declared_kind": {"enum": ["determined", "open"]},
        "outcome": {"enum": ["selected"]},
        "relented_avoids": {
          "type": "array",
          "items": {"$ref": "#/$defs/launch_constraint_predicate"}
        }
      },
      "additionalProperties": false
    },
    "launch_resolution_report": {
      "type": "object",
      "required": ["selection", "leaves"],
      "properties": {
        "session_id": {"$ref": "#/$defs/opaque_id"},
        "launch_resolution_id": {"$ref": "#/$defs/opaque_id"},
        "selection": {"enum": ["ordered", "random"]},
        "leaves": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/launch_resolution_leaf"}
        },
        "host": {"$ref": "#/$defs/launch_deduced_host"},
        "evidence_bundle": {"$ref": "#/$defs/launch_evidence_bundle"},
        "relations": {
          "type": "array",
          "items": {"$ref": "#/$defs/launch_relation"}
        }
      },
      "additionalProperties": true
    },
    "minted_composition": {
      "description": "The variant x deduced-host join minted at launch resolution under duo.config/v3. Compositions are never authored; this entry is where a composition is named (2026-08-24 handoff 22; notes/42 section 4 step 2, section 6.9).",
      "type": "object",
      "required": ["variant"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "agent_runtime": {"type": "string", "minLength": 1},
        "model_line": {"type": "string", "minLength": 1},
        "model_family": {"type": "string", "minLength": 1},
        "host_kind": {"type": "string", "minLength": 1},
        "host_instance_id": {"$ref": "#/$defs/opaque_id"}
      },
      "additionalProperties": true
    },
    "launch_relation": {
      "type": "object",
      "required": ["kind", "leaves"],
      "properties": {
        "kind": {"$ref": "#/$defs/launch_relation_kind"},
        "leaves": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "launch_ambient_capture": {
      "description": "One ambient environment variable captured once at materialization (M1) and recorded even when outranked.",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": "string"},
        "captured_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": true
    },
    "launch_outranked_evidence": {
      "description": "Host evidence captured at materialization and outranked by a higher rung of the fixed deduction ranking (explicit flag > workspace correlation > ambient environment > policy default).",
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {"$ref": "#/$defs/host_source"},
        "kind": {"type": "string", "minLength": 1},
        "instance_label": {"type": "string", "minLength": 1},
        "fact_id": {"$ref": "#/$defs/opaque_id"},
        "captures": {
          "type": "array",
          "items": {"$ref": "#/$defs/launch_ambient_capture"}
        },
        "detail": {"type": "string"}
      },
      "additionalProperties": true
    },
    "launch_deduced_host": {
      "description": "The one host instance deduced for this launch at materialization, with the rung that produced it and every captured-but-outranked piece of evidence.",
      "type": "object",
      "required": ["kind", "host_source"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "instance_id": {"$ref": "#/$defs/opaque_id"},
        "instance_label": {"type": "string", "minLength": 1},
        "host_source": {"$ref": "#/$defs/host_source"},
        "workspace_id": {"$ref": "#/$defs/opaque_id"},
        "outranked_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/launch_outranked_evidence"}
        }
      },
      "additionalProperties": true
    },
    "launch_evidence_bundle": {
      "description": "References to the materialized evidence bundle assembled at M1/M2 and immutable once handed to the resolver (notes/42 section 5 input 5).",
      "type": "object",
      "properties": {
        "correlation_fact_id": {"$ref": "#/$defs/opaque_id"},
        "correlation_fingerprint": {"type": "object"},
        "ambient_captures": {
          "type": "array",
          "items": {"$ref": "#/$defs/launch_ambient_capture"}
        },
        "provider_fact_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/opaque_id"}
        }
      },
      "additionalProperties": true
    },
    "launch_pointer_set": {
      "description": "The closed set of ways out named by a launch failure: the host override flag, provider enable, and the audited workspace host rebind verb.",
      "type": "object",
      "properties": {
        "override_flag": {"type": "string", "minLength": 1},
        "provider_enable": {"type": "string", "minLength": 1},
        "workspace_host_rebind": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "launch_elimination_tally": {
      "description": "Per-reason elimination count for one leaf. Step-3 reasons appear here too when a mixed case reports under launch.constraints_exhausted.",
      "type": "object",
      "required": ["reason", "count"],
      "properties": {
        "leaf": {"type": "string", "minLength": 1},
        "reason": {"$ref": "#/$defs/launch_elimination_reason"},
        "count": {"type": "integer", "minimum": 0},
        "detail": {"type": "string"}
      },
      "additionalProperties": true
    },
    "launch_failure_candidate": {
      "type": "object",
      "properties": {
        "leaf": {"type": "string", "minLength": 1},
        "declaration_locator": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "composition": {"$ref": "#/$defs/minted_composition"},
        "agent_runtime": {"type": "string", "minLength": 1},
        "model_line": {"type": "string", "minLength": 1},
        "model_family": {"type": "string", "minLength": 1},
        "elimination_reason": {"$ref": "#/$defs/launch_elimination_reason"}
      },
      "additionalProperties": true
    },
    "launch_failure_details": {
      "description": "Safe details for launch.constraints_exhausted and launch.no_eligible_candidate. Every property is optional: fields added on 2026-08-24 (handoff 22) are compatible adds beside the handoff-18 payload.",
      "type": "object",
      "properties": {
        "requested_preset": {"type": "string", "minLength": 1},
        "constraints": {
          "type": "object",
          "properties": {
            "require": {
              "type": "array",
              "items": {"$ref": "#/$defs/launch_constraint_predicate"}
            },
            "avoid": {
              "type": "array",
              "items": {"$ref": "#/$defs/launch_constraint_predicate"}
            }
          },
          "additionalProperties": true
        },
        "candidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/launch_failure_candidate"}
        },
        "elimination_tallies": {
          "type": "array",
          "items": {"$ref": "#/$defs/launch_elimination_tally"}
        },
        "relations": {
          "type": "array",
          "items": {"$ref": "#/$defs/launch_relation"}
        },
        "host": {"$ref": "#/$defs/launch_deduced_host"},
        "evidence_bundle": {"$ref": "#/$defs/launch_evidence_bundle"},
        "pointers": {"$ref": "#/$defs/launch_pointer_set"},
        "complete_assignments_survived": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "launch_host_deduction_rung": {
      "description": "One rung of the fixed host-deduction ranking, in rank order, recording whether it was consulted and whether it yielded a host.",
      "type": "object",
      "required": ["source", "consulted"],
      "properties": {
        "source": {"$ref": "#/$defs/host_source"},
        "consulted": {"type": "boolean"},
        "yielded_host": {"type": "boolean"},
        "kind": {"type": "string", "minLength": 1},
        "instance_label": {"type": "string", "minLength": 1},
        "detail": {"type": "string"}
      },
      "additionalProperties": true
    },
    "launch_host_unresolved_details": {
      "description": "Safe details for launch.host_unresolved. The payload names the deduction trail: every rung of the fixed ranking and why it produced no host.",
      "type": "object",
      "required": ["deduction_trail"],
      "properties": {
        "workspace_id": {"$ref": "#/$defs/opaque_id"},
        "requested_preset": {"type": "string", "minLength": 1},
        "deduction_trail": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/launch_host_deduction_rung"}
        },
        "enabled_kinds": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_bundle": {"$ref": "#/$defs/launch_evidence_bundle"},
        "pointers": {"$ref": "#/$defs/launch_pointer_set"}
      },
      "additionalProperties": true
    },
    "config_declaration_details": {
      "description": "Safe details for a declaration-ambiguity failure: the locator of the offending declaration, and the configuration schema that produced it.",
      "type": "object",
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "config_schema": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "launch_host_unresolved_code": {
      "description": "Stable code (2026-08-24 handoff 22; notes/43 record 8, item 15 branch A). Materialization failure: host deduction produced no host (every kind disabled, no correlation, no ambient evidence, empty policy default). Class unavailable, effect no_effect.",
      "const": "launch.host_unresolved"
    },
    "config_variant_unresolved_code": {
      "description": "Stable code (2026-08-24 handoff 22; notes/43 record 8, item 15 branch A). The declaration-ambiguity successor to config.composition_unresolved under duo.config/v3: a missing or ambiguous variant or runtime reference, a malformed preset, or an exceeded declaration-complexity ceiling. Class unavailable, effect no_effect.",
      "const": "config.variant_unresolved"
    },
    "config_composition_unresolved_code": {
      "description": "Deprecated 2026-08-24 (handoff 22; notes/43 record 8, item 15 branch A). Still a registered stable code, emitted for duo.config/v2 documents only. No duo.config/v3 resolution emits it; its successor is config.variant_unresolved.",
      "deprecated": true,
      "const": "config.composition_unresolved"
    },
    "human_writer_evidence_grade": {"enum": ["attributed", "writer_presence", "turn_derived", "none"]},
    "condition_view_data": {
      "type": "object",
      "properties": {
        "value": {"$ref": "#/$defs/condition_value"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "freshness": {"$ref": "#/$defs/freshness"}
      }
    },
    "model_identity": {
      "type": "object",
      "properties": {
        "source_provider_key": {"type": "string", "minLength": 1},
        "source_model_key": {"type": "string", "minLength": 1},
        "vendor_key": {"type": "string"},
        "source_display_name": {"type": "string"},
        "normalized_family": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "mapping_version": {"type": "string"},
            "evidence": {"type": "string"}
          },
          "additionalProperties": true
        },
        "context_limit": {"type": "integer", "minimum": 0},
        "execution_modifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_key": {"type": "string", "minLength": 1},
              "source_value": {},
              "normalized_meaning": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "source_effort": {"type": "string"},
        "normalized_effort": {
          "type": "object",
          "properties": {
            "level": {"type": "string"},
            "vocabulary_version": {"type": "string"},
            "unknown_behavior": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "runtime_configuration_view": {
      "type": "object",
      "properties": {
        "session_id": {"$ref": "#/$defs/opaque_id"},
        "runtime_instance_id": {"$ref": "#/$defs/opaque_id"},
        "revision": {"$ref": "#/$defs/decimal"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "freshness": {"$ref": "#/$defs/freshness"},
        "effective_at": {"$ref": "#/$defs/timestamp"},
        "computed_at": {"$ref": "#/$defs/timestamp"},
        "determining_observations": {"type": "array", "items": {"$ref": "#/$defs/opaque_id"}},
        "selected": {"$ref": "#/$defs/model_identity"},
        "selected_working_mode": {"$ref": "#/$defs/working_mode"},
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"field": {"type": "string"}, "reason": {"type": "string"}}
          }
        },
        "reasons": {"type": "array"}
      },
      "additionalProperties": true
    },
    "working_mode": {
      "type": "object",
      "properties": {
        "source_key": {"type": "string", "minLength": 1},
        "source_value": {"type": "string"},
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_key": {"type": "string", "minLength": 1},
              "source_value": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "normalized_class": {
          "type": "object",
          "properties": {
            "class": {"type": "string"},
            "vocabulary_version": {"type": "string"},
            "evidence": {"type": "string"}
          },
          "additionalProperties": true
        },
        "source_display_name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "effective_configuration_record": {
      "type": "object",
      "properties": {
        "effective": {"$ref": "#/$defs/model_identity"},
        "source_record": {"$ref": "#/$defs/target"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "freshness": {"$ref": "#/$defs/freshness"}
      },
      "additionalProperties": true
    },
    "support_view": {
      "type": "object",
      "properties": {
        "availability": {"$ref": "#/$defs/availability"},
        "quality": {"$ref": "#/$defs/quality"},
        "realization": {"$ref": "#/$defs/realization"},
        "terminal_fidelity": {"$ref": "#/$defs/terminal_fidelity"}
      }
    },
    "session_attachment_inspect": {
      "type": "object",
      "required": [
        "attachment_id",
        "state",
        "integration_instance",
        "epoch",
        "container",
        "claim_held"
      ],
      "properties": {
        "attachment_id": {"$ref": "#/$defs/opaque_id"},
        "state": {"type": "string", "minLength": 1},
        "integration_instance": {"type": "string", "minLength": 1},
        "epoch": {
          "type": "object",
          "required": ["kind", "value", "scope"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "value": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1}
          }
        },
        "container": {"type": "string", "minLength": 1},
        "process_birth": {
          "type": "object",
          "required": ["pid", "started_at"],
          "properties": {
            "pid": {"type": "integer"},
            "started_at": {"$ref": "#/$defs/timestamp"}
          }
        },
        "claim_held": {"type": "boolean"},
        "reattach_command": {"type": "string", "minLength": 1}
      }
    },
    "retry": {
      "type": "object",
      "required": ["safe", "action"],
      "properties": {
        "safe": {"type": "boolean"},
        "action": {"type": "string", "minLength": 1},
        "after_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"$ref": "#/$defs/opaque_id"}
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["class", "code", "message", "retry", "effect"],
      "properties": {
        "class": {
          "enum": [
            "invalid",
            "not_found",
            "conflict",
            "unsupported",
            "unavailable",
            "degraded",
            "unauthorized",
            "disconnected",
            "timeout",
            "indeterminate",
            "internal"
          ]
        },
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
        "message": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "retry": {"$ref": "#/$defs/retry"},
        "effect": {"$ref": "#/$defs/effect"},
        "details": {"type": "object"},
        "diagnostics": {"type": "object"}
      },
      "additionalProperties": true
    },
    "success": {
      "type": "object",
      "required": ["schema", "request_id", "operation", "result"],
      "properties": {
        "schema": {"$ref": "#/$defs/schema"},
        "request_id": {"$ref": "#/$defs/opaque_id"},
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
        "result": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "object"}},
        "features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "failure": {
      "type": "object",
      "required": ["schema", "request_id", "operation", "error"],
      "properties": {
        "schema": {"$ref": "#/$defs/schema"},
        "request_id": {"$ref": "#/$defs/opaque_id"},
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
        "error": {"$ref": "#/$defs/error"}
      },
      "additionalProperties": true
    },
    "stream_item": {
      "type": "object",
      "required": ["schema", "stream", "scope", "item_id", "position", "recorded_at", "kind", "subject", "data"],
      "properties": {
        "schema": {"$ref": "#/$defs/schema"},
        "stream": {"type": "string", "minLength": 1},
        "scope": {"type": "object", "minProperties": 1},
        "item_id": {"$ref": "#/$defs/opaque_id"},
        "position": {"$ref": "#/$defs/decimal"},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "kind": {"type": "string", "minLength": 1},
        "subject": {"$ref": "#/$defs/target"},
        "data": {}
      },
      "additionalProperties": true
    }
  }
}
