{
  "schema": "duo.config/v3",
  "authority": {
    "socket": "/run/user/1000/duo/duo.sock"
  },
  "workspaces": {
    "main": {
      "root": "/work/example",
      "discovery": "explicit"
    }
  },
  "session_hosts": {
    "prefer": ["herdr"],
    "kinds": {
      "herdr": {
        "enabled": true,
        "launch_target": "tab",
        "close_on_exit": true
      },
      "tmux": {
        "enabled": false
      }
    },
    "deduce": {
      "workspace": {
        "enabled": true
      },
      "cwd": {
        "enabled": true
      },
      "env": {
        "enabled": true
      },
      "default": {
        "enabled": true
      }
    }
  },
  "agent_runtimes": {
    "claude": {
      "kind": "claude",
      "executable": "claude",
      "arguments": []
    },
    "pi": {
      "kind": "pi",
      "executable": "pi"
    }
  },
  "launch_variants": {
    "claude_opus": {
      "agent_runtime": "claude",
      "provider": "anthropic",
      "model_family": "claude",
      "model_line": "opus-5",
      "append_arguments": ["--model", "opus"]
    },
    "claude_sonnet": {
      "agent_runtime": "claude",
      "provider": "anthropic",
      "model_family": "claude",
      "model_line": "sonnet-5",
      "append_arguments": ["--model", "sonnet"]
    },
    "pi_gpt56": {
      "agent_runtime": "pi",
      "provider": "openai_api",
      "model_family": "gpt",
      "model_line": "gpt-5.6",
      "append_arguments": ["--model", "openai/gpt-5.6"]
    }
  },
  "presets": {
    "review": {
      "selection": "ordered",
      "leaves": {
        "main": {
          "candidates": [
            {
              "variant": "claude_sonnet"
            },
            {
              "variant": "pi_gpt56"
            }
          ]
        }
      }
    },
    "build_and_verify": {
      "selection": "ordered",
      "leaves": {
        "builder": {
          "candidates": [
            {
              "variant": "claude_sonnet"
            },
            {
              "variant": "pi_gpt56"
            }
          ]
        },
        "verifier": {
          "candidates": [
            {
              "variant": "pi_gpt56"
            },
            {
              "variant": "claude_sonnet"
            }
          ]
        }
      },
      "relations": [
        {
          "kind": "distinct_model_family",
          "leaves": ["builder", "verifier"]
        }
      ]
    }
  }
}
